# Copy to .env.local and fill in. Never commit real values.

# Supabase (publishable key is browser-safe; secret key is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenRouter (server-only)
OPENROUTER_API_KEY=

# Model IDs on OpenRouter (e.g. MODEL_EMBED=openai/text-embedding-3-small, 1536 dims)
MODEL_PROFESSOR=
MODEL_CHECKER=
MODEL_EMBED=

# Vercel cron auth (server-only). Generate with: openssl rand -hex 32
CRON_SECRET=
